APP_NAME=ระบบแจ้งเคลมประกัน
# public URL, used in emails (optional)
APP_URL=

# ===== Admins (comma separated). Only these emails can approve users and manage claims =====
ADMIN_EMAILS=

# ===== Email =====
# graph   = Microsoft 365 (Graph sendMail, needs Mail.Send only - no SharePoint access)
# console = print emails to the server log. TEST ONLY - refused when VERCEL_ENV=production
MAIL_PROVIDER=graph
MAIL_SENDER=
TENANT_ID=
CLIENT_ID=
# Leave EMPTY on Vercel (uses Vercel OIDC federation). Only for running outside Vercel.
CLIENT_SECRET=
# who receives new-claim notifications (empty = ADMIN_EMAILS)
CLAIM_NOTIFY_EMAIL=

# ===== Privacy notice shown on the registration form (from Legal/DPO) =====
PRIVACY_NOTICE_URL=

# ===== CAPTCHA: Cloudflare Turnstile (protects register + login code requests) =====
# Production: real keys from Cloudflare dashboard -> Turnstile. REQUIRED in Production (app refuses to send codes without it).
# Preview/Development: Cloudflare test keys  site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# hostnames allowed in the Turnstile result, comma separated (Production), e.g. claim.example.com,your-project.vercel.app
TURNSTILE_ALLOWED_HOSTNAMES=
# set to false ONLY to run Production without CAPTCHA (not recommended)
CAPTCHA_REQUIRED=

# ===== Security =====
# openssl rand -base64 48
OTP_PEPPER=
OTP_TTL_MINUTES=10
SESSION_HOURS=8

# ===== Upstash Redis (data store for Phase 1) =====
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
